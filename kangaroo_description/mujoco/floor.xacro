<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="mujoco_environment">

    <xacro:macro name="mj_scene" params="">
      <compiler strippath="false" discardvisual="false" balanceinertia="true" angle="radian" />
      <option integrator="implicitfast" />
      <statistic center="0 0 1" extent="1.8" meansize="0.04"/>

      <visual>
        <headlight diffuse=".8 .8 .8" ambient=".4 .4 .4" specular="1 1 1"/>
        <rgba force="1 0 0 1"/>
        <global azimuth="160" elevation="-20"/>
        <map force="0.01"/>
        <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
        <quality shadowsize="8192"/>
      </visual>

      <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.45 0.59 0.79" rgb2="0.30 0.41 0.60" width="800" height="800"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
        width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
      </asset>

      <worldbody>
        <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0"/>
      </worldbody>

    </xacro:macro>
</robot>